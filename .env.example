# Umami Cloud. Leave UMAMI_URL unset to use https://api.umami.is/v1.
UMAMI_API_KEY=

# Optional Cloud region: us or eu. Appended to the Cloud base URL.
# UMAMI_CLOUD_REGION=us

# Self-hosted site origin (no /api suffix). Use this with a username and
# password, or with a self-hosted API key.
# UMAMI_URL=https://analytics.example.com
# UMAMI_USERNAME=
# UMAMI_PASSWORD=

# How the API key is sent. Default sends both headers.
# both | bearer | x-umami-api-key
# UMAMI_API_KEY_HEADER=both

# IANA timezone used when a tool call omits one.
# UMAMI_TIMEZONE=America/New_York

# stdio (default) or http. Docker sets http.
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# PORT=8787

# Required for HTTP. Clients send Authorization: Bearer <this value>.
# MCP_AUTH_TOKEN=

# Optional DNS-rebinding allow lists, used when a proxy is not in front.
# MCP_ALLOWED_HOSTS=analytics.example.com
# MCP_ALLOWED_ORIGINS=https://analytics.example.com
